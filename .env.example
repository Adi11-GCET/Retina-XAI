# ===================================================================
# RETINA-XAI / DrishtiAI Configuration Template (.env.example)
# ===================================================================
# Copy this file to .env for local overrides. NEVER commit .env to git.

# -------------------------------------------------------------------
# Flask Server Configuration
# -------------------------------------------------------------------
SECRET_KEY=your-secure-flask-secret-key-replace-in-production
FLASK_ENV=development
PORT=5000

# -------------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------------
# On Render: Attach a Render PostgreSQL database and set DATABASE_URL.
# If omitted or left blank, the application automatically uses local SQLite (database/database.db).
# Example: DATABASE_URL=postgresql://user:password@dpg-xxxxx-a.oregon-postgres.render.com/retina_xai_db
DATABASE_URL=

# -------------------------------------------------------------------
# Mobile OTP Authentication & SMS Gateways Configuration
# -------------------------------------------------------------------
# AUTH_MODE: 'development' (allows simulation) or 'production' (strictly enforces real SMS)
AUTH_MODE=development

# DEMO_OTP_ENABLED: Set to 'false' in production. When false, universal demo code (652070)
# is strictly rejected by the backend.
DEMO_OTP_ENABLED=true

# SMS_PROVIDER: Options: fast2sms, twilio, msg91, mock (dev only)
# In production, if credentials are not configured, the system fails safely with
# "OTP service is currently unavailable. Please try again later."
SMS_PROVIDER=mock

# SMS Provider Credentials:
# - For Fast2SMS (India):
#   SMS_API_KEY=your_fast2sms_authorization_key
#   SMS_SENDER_ID=DRSHTI
#
# - For Twilio (Global/India):
#   SMS_API_KEY=your_twilio_account_sid
#   SMS_API_SECRET=your_twilio_auth_token
#   SMS_SENDER_ID=+1XXXXXXXXXX (or Twilio Messaging Service SID)
#
# - For MSG91 (India):
#   SMS_API_KEY=your_msg91_authkey
#   SMS_TEMPLATE_ID=your_dlt_approved_template_id
#
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=DRSHTI
SMS_TEMPLATE_ID=
SMS_REGION=in

# Legacy aliases supported for backwards compatibility:
# OTP_PROVIDER=mock
# OTP_API_KEY=
# OTP_API_SECRET=
# OTP_SENDER_ID=DRSHTI

# -------------------------------------------------------------------
# DrishtiAI Assistant External AI Configuration (Optional)
# -------------------------------------------------------------------
# Options: gemini, openai
# If unset or if API key is not provided, the chatbot seamlessly uses
# the built-in dual-language (English/Hindi) Clinical FAQ Knowledge Base.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# -------------------------------------------------------------------
# Storage Configuration
# -------------------------------------------------------------------
# Defaults to local filesystem (static/uploads & static/generated).
STORAGE_PROVIDER=local
